server {
    listen 443 ssl;
    server_name repo.example.com;

    # --------------------------------------------------
    # Logs (host-specific)
    # --------------------------------------------------
    access_log /var/log/nginx/repo.example.com.log;
    error_log  /var/log/nginx/repo.example.com.error.log warn;

    # --------------------------------------------------
    # TLS
    # --------------------------------------------------
    ssl_certificate     /etc/letsencrypt/live/repo.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/repo.example.com/privkey.pem;

    ssl_session_cache   shared:SSL:20m;
    ssl_session_timeout 10m;

    # --------------------------------------------------
    # Public GPG key (static, host-served)
    # --------------------------------------------------
    location = /repo.gpg {
        alias /var/www/repo.example.com/key/repo.gpg;
        default_type application/pgp-keys;
        add_header Cache-Control "no-store" always;
    }

    # --------------------------------------------------
    # Debian repository content only
    # --------------------------------------------------
    location ~ ^/(dists|pool)/ {
        proxy_pass http://127.0.0.1:8090;

        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $proxy_protocol_addr;
        proxy_set_header X-Forwarded-For   $proxy_protocol_addr;
        proxy_set_header X-Forwarded-Proto https;

        proxy_connect_timeout 5s;
        proxy_read_timeout    120s;

        proxy_buffering off;
        proxy_request_buffering off;

        add_header Cache-Control "no-store" always;
    }

    # --------------------------------------------------
    # Everything else: hard drop
    # --------------------------------------------------
    location / {
        return 444;
    }
}

